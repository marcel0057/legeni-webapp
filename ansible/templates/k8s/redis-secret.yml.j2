# Mot de passe Redis, issu du coffre Ansible (vars/vault.yml).
# "data" encodé en base64 plutôt que "stringData" : le module kubernetes.core.k8s
# compare alors à l'identique et reste idempotent (changed=0 à la relance).
apiVersion: v1
kind: Secret
metadata:
  name: redis-auth
  namespace: {{ k8s_namespace }}
  labels:
    app.kubernetes.io/name: redis
    app.kubernetes.io/part-of: legeni-webapp
type: Opaque
data:
  password: {{ redis_password | b64encode }}
