services:
  jenkins:
    build: .
    image: {{ jenkins_image }}
    container_name: {{ jenkins_container_name }}
    restart: unless-stopped
    labels:
      projet: "{{ jenkins_tp_label }}"
    group_add:
      - "{{ jenkins_docker_gid }}"
    ports:
      - "{{ jenkins_http_port }}:8080"
      - "{{ jenkins_agent_port }}:50000"
    volumes:
      - jenkins_home:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - {{ jenkins_network }}

volumes:
  jenkins_home:

networks:
  {{ jenkins_network }}:
    external: true
